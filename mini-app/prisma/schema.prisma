generator client {
  provider = "prisma-client"
  output   = "../backend/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      Int                      @id @default(autoincrement())
  telegramId              BigInt?                  @unique
  username                String?
  firstName               String
  lastName                String?
  languageCode            String?
  age                     Int?
  gender                  Gender?
  weight                  Float?
  height                  Float?
  goal                    Goal?
  onboardingCompleted     Boolean                  @default(false)
  level                   Int                      @default(1)
  xp                      Int                      @default(0)
  workouts                Int                      @default(0)
  streak                  Int                      @default(0)
  premiumPlan             String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  webId                   String?                  @unique
  nutritionDays           NutritionDay[]
  progress                Progress[]
  workoutSessions         WorkoutSession[]
  coachProfile            CoachProfile?
  coachRelationships      CoachClient[]            @relation("CoachUser")
  coachInvites            CoachInvite[]            @relation("CoachInvites")
  clientRelationships     CoachClient[]            @relation("ClientUser")
  trainingWorkouts        TrainingWorkout[]        @relation("TrainingWorkoutCoach")
  trainingPrograms        TrainingProgram[]        @relation("TrainingProgramCoach")
  approvedPrograms        TrainingProgram[]        @relation("TrainingProgramApprovedBy")
  programAssignments      ProgramAssignment[]      @relation("ProgramClient")
  assignedPrograms        ProgramAssignment[]      @relation("ProgramAssignedBy")
  subscriptions           Subscription[]
  programEntitlements     ProgramEntitlement[]
  programPurchases        ProgramPurchase[]
  authIdentities          AuthIdentity[]
  authSessions            AuthSession[]
  emailVerificationTokens EmailVerificationToken[]
  videoReviewsAsClient    VideoReview[]            @relation("VideoReviewClient")
  videoReviewsAsCoach     VideoReview[]            @relation("VideoReviewCoach")

  @@index([createdAt])
}

model CoachProfile {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  displayName    String
  bio            String?
  specialization String?
  photoUrl       String?
  isVerified     Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive])
}

model CoachClient {
  id        Int      @id @default(autoincrement())
  coachId   Int
  clientId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coach  User @relation("CoachUser", fields: [coachId], references: [id], onDelete: Cascade)
  client User @relation("ClientUser", fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([coachId, clientId])
  @@unique([clientId])
  @@index([coachId])
}

enum ProgramEntitlementSource {
  COACH_ASSIGNMENT
  FREE_CLAIM
  PURCHASE
  SUBSCRIPTION
  ADMIN_GRANT
}

enum ProgramStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum VideoReviewStatus {
  PENDING
  REVIEWED
  REJECTED
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
}

model AuthIdentity {
  id             Int          @id @default(autoincrement())
  userId         Int
  provider       AuthProvider
  providerUserId String
  email          String?
  emailVerified  Boolean      @default(false)
  passwordHash   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@index([email])
}

model EmailVerificationToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthSession {
  id        Int      @id @default(autoincrement())
  userId    Int
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model WorkoutSession {
  id                Int                       @id @default(autoincrement())
  userId            Int
  workoutId         String
  workoutName       String
  duration          Int                       @default(0)
  xp                Int                       @default(0)
  status            WorkoutStatus             @default(COMPLETED)
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sets              WorkoutSet[]
  programCompletion ProgramWorkoutCompletion?
  videoReviews      VideoReview[]

  @@index([userId])
  @@index([userId, createdAt])
  @@index([status])
}

model WorkoutSet {
  id           Int            @id @default(autoincrement())
  workoutId    Int
  exerciseId   String
  exerciseName String
  setNumber    Int
  repetitions  Int?
  weight       Float?
  duration     Int?
  completed    Boolean        @default(false)
  createdAt    DateTime       @default(now())
  workout      WorkoutSession @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@index([workoutId])
}

model VideoReview {
  id               Int  @id @default(autoincrement())
  clientId         Int
  coachId          Int
  workoutSessionId Int?

  exerciseName String
  videoUrl     String
  athleteNote  String?

  coachFeedback String?
  status        VideoReviewStatus @default(PENDING)

  submittedAt DateTime  @default(now())
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  client User @relation("VideoReviewClient", fields: [clientId], references: [id], onDelete: Cascade)
  coach  User @relation("VideoReviewCoach", fields: [coachId], references: [id], onDelete: Cascade)

  workoutSession WorkoutSession? @relation(fields: [workoutSessionId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([coachId])
  @@index([status])
  @@index([coachId, status])
  @@index([submittedAt])
  @@index([workoutSessionId])
}

model Progress {
  id         Int      @id @default(autoincrement())
  userId     Int
  weight     Float?
  bodyFat    Float?
  muscleMass Float?
  note       String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model NutritionDay {
  id        Int         @id @default(autoincrement())
  userId    Int
  date      DateTime
  water     Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  meals     FoodEntry[]
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model FoodEntry {
  id             Int          @id @default(autoincrement())
  nutritionDayId Int
  name           String
  meal           MealType
  calories       Float        @default(0)
  protein        Float        @default(0)
  fat            Float        @default(0)
  carbs          Float        @default(0)
  amount         Float?
  unit           String?
  createdAt      DateTime     @default(now())
  nutritionDay   NutritionDay @relation(fields: [nutritionDayId], references: [id], onDelete: Cascade)

  @@index([nutritionDayId])
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Goal {
  MUSCLE
  LOSE_WEIGHT
  MAINTAIN
  ENDURANCE
  STRENGTH
  FITNESS
}

enum WorkoutStatus {
  COMPLETED
  CANCELED
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model Exercise {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  name         String
  description  String?
  instructions String?
  muscleGroup  String?
  equipment    String?
  demoVideoUrl String?
  thumbnailUrl String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workoutExercises WorkoutExercise[]

  @@index([name])
  @@index([muscleGroup])
  @@index([isActive])
}

model TrainingWorkout {
  id          Int      @id @default(autoincrement())
  coachId     Int
  name        String
  description String?
  duration    Int?
  difficulty  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  coach           User              @relation("TrainingWorkoutCoach", fields: [coachId], references: [id], onDelete: Cascade)
  exercises       WorkoutExercise[]
  programWorkouts ProgramWorkout[]

  @@index([coachId])
  @@index([isActive])
}

model WorkoutExercise {
  id             Int      @id @default(autoincrement())
  workoutId      Int
  exerciseId     Int
  position       Int
  sets           Int?
  repetitions    Int?
  minRepetitions Int?
  maxRepetitions Int?
  duration       Int?
  restSeconds    Int?
  targetWeight   Float?
  tempo          String?
  coachNotes     String?
  coachVideoUrl  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workout  TrainingWorkout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([workoutId, position])
  @@index([workoutId])
  @@index([exerciseId])
}

model TrainingProgram {
  id            Int     @id @default(autoincrement())
  coachId       Int
  name          String
  description   String?
  durationWeeks Int?

  status      ProgramStatus @default(DRAFT)
  isPublished Boolean       @default(false)

  priceCents Int?
  currency   String @default("EUR")

  appleProductId  String? @unique
  googleProductId String? @unique

  approvedBy  Int?
  approvedAt  DateTime?
  publishedAt DateTime?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coach          User  @relation("TrainingProgramCoach", fields: [coachId], references: [id], onDelete: Cascade)
  approvedByUser User? @relation("TrainingProgramApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)

  workouts     ProgramWorkout[]
  assignments  ProgramAssignment[]
  entitlements ProgramEntitlement[]
  purchases    ProgramPurchase[]

  @@index([coachId])
  @@index([approvedBy])
  @@index([status])
  @@index([isPublished])
  @@index([isActive])
}

model ProgramWorkout {
  id        Int      @id @default(autoincrement())
  programId Int
  workoutId Int
  week      Int?
  day       Int?
  position  Int
  createdAt DateTime @default(now())

  program     TrainingProgram            @relation(fields: [programId], references: [id], onDelete: Cascade)
  workout     TrainingWorkout            @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  completions ProgramWorkoutCompletion[]

  @@unique([programId, position])
  @@index([programId])
  @@index([workoutId])
}

model ProgramPurchase {
  id        Int @id @default(autoincrement())
  programId Int
  userId    Int

  provider String
  platform String

  productId     String
  transactionId String @unique

  originalTransactionId String?

  amountCents Int?
  currency    String?

  purchasedAt DateTime
  verifiedAt  DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  program TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@index([userId])
  @@index([provider])
  @@index([platform])
  @@index([productId])
  @@index([purchasedAt])
}

model ProgramEntitlement {
  id        Int                      @id @default(autoincrement())
  programId Int
  userId    Int
  source    ProgramEntitlementSource

  isActive  Boolean   @default(true)
  startsAt  DateTime  @default(now())
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  program TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@index([userId])
  @@index([source])
  @@index([isActive])
  @@index([userId, programId, isActive])
  @@index([expiresAt])
}

model ProgramAssignment {
  id         Int       @id @default(autoincrement())
  programId  Int
  clientId   Int
  assignedBy Int?
  startDate  DateTime?
  endDate    DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  program     TrainingProgram            @relation(fields: [programId], references: [id], onDelete: Cascade)
  client      User                       @relation("ProgramClient", fields: [clientId], references: [id], onDelete: Cascade)
  coach       User?                      @relation("ProgramAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull)
  completions ProgramWorkoutCompletion[]

  @@index([programId])
  @@index([clientId])
  @@index([assignedBy])
  @@index([clientId, isActive])
}

model ProgramWorkoutCompletion {
  id               Int      @id @default(autoincrement())
  assignmentId     Int
  programWorkoutId Int
  workoutSessionId Int      @unique
  completedAt      DateTime @default(now())
  createdAt        DateTime @default(now())

  assignment     ProgramAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  programWorkout ProgramWorkout    @relation(fields: [programWorkoutId], references: [id], onDelete: Cascade)
  workoutSession WorkoutSession    @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, programWorkoutId])
  @@index([assignmentId])
  @@index([programWorkoutId])
}

model CoachInvite {
  id         Int       @id @default(autoincrement())
  token      String    @unique
  coachId    Int
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  coach User @relation("CoachInvites", fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId])
  @@index([expiresAt])
}

model Subscription {
  id                    Int       @id @default(autoincrement())
  userId                Int
  provider              String
  platform              String
  productId             String
  plan                  String
  status                String
  transactionId         String?   @unique
  originalTransactionId String?
  purchasedAt           DateTime?
  expiresAt             DateTime?
  lastVerifiedAt        DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([originalTransactionId])
  @@index([expiresAt])
}
