generator client {
  provider = "prisma-client"
  output   = "../backend/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  Int                 @id @default(autoincrement())
  telegramId          BigInt?             @unique
  username            String?
  firstName           String
  lastName            String?
  languageCode        String?
  age                 Int?
  gender              Gender?
  weight              Float?
  height              Float?
  goal                Goal?
  onboardingCompleted Boolean             @default(false)
  level               Int                 @default(1)
  xp                  Int                 @default(0)
  workouts            Int                 @default(0)
  streak              Int                 @default(0)
  premiumPlan         String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  webId               String?             @unique
  nutritionDays       NutritionDay[]
  progress            Progress[]
  workoutSessions     WorkoutSession[]
  coachProfile        CoachProfile?
  coachRelationships  CoachClient[]       @relation("CoachUser")
  coachInvites        CoachInvite[]       @relation("CoachInvites")
  clientRelationships CoachClient[]       @relation("ClientUser")
  trainingWorkouts    TrainingWorkout[]   @relation("TrainingWorkoutCoach")
  trainingPrograms    TrainingProgram[]   @relation("TrainingProgramCoach")
  programAssignments  ProgramAssignment[] @relation("ProgramClient")
  assignedPrograms    ProgramAssignment[] @relation("ProgramAssignedBy")
  subscriptions       Subscription[]

  @@index([createdAt])
}

model CoachProfile {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  displayName    String
  bio            String?
  specialization String?
  photoUrl       String?
  isVerified     Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isActive])
}

model CoachClient {
  id        Int      @id @default(autoincrement())
  coachId   Int
  clientId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coach  User @relation("CoachUser", fields: [coachId], references: [id], onDelete: Cascade)
  client User @relation("ClientUser", fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([coachId, clientId])
  @@unique([clientId])
  @@index([coachId])
}

model WorkoutSession {
  id                Int                       @id @default(autoincrement())
  userId            Int
  workoutId         String
  workoutName       String
  duration          Int                       @default(0)
  xp                Int                       @default(0)
  status            WorkoutStatus             @default(COMPLETED)
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sets              WorkoutSet[]
  programCompletion ProgramWorkoutCompletion?

  @@index([userId])
  @@index([userId, createdAt])
  @@index([status])
}

model WorkoutSet {
  id           Int            @id @default(autoincrement())
  workoutId    Int
  exerciseId   String
  exerciseName String
  setNumber    Int
  repetitions  Int?
  weight       Float?
  duration     Int?
  completed    Boolean        @default(false)
  createdAt    DateTime       @default(now())
  workout      WorkoutSession @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@index([workoutId])
}

model Progress {
  id         Int      @id @default(autoincrement())
  userId     Int
  weight     Float?
  bodyFat    Float?
  muscleMass Float?
  note       String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model NutritionDay {
  id        Int         @id @default(autoincrement())
  userId    Int
  date      DateTime
  water     Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  meals     FoodEntry[]
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model FoodEntry {
  id             Int          @id @default(autoincrement())
  nutritionDayId Int
  name           String
  meal           MealType
  calories       Float        @default(0)
  protein        Float        @default(0)
  fat            Float        @default(0)
  carbs          Float        @default(0)
  amount         Float?
  unit           String?
  createdAt      DateTime     @default(now())
  nutritionDay   NutritionDay @relation(fields: [nutritionDayId], references: [id], onDelete: Cascade)

  @@index([nutritionDayId])
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Goal {
  MUSCLE
  LOSE_WEIGHT
  MAINTAIN
  ENDURANCE
  STRENGTH
  FITNESS
}

enum WorkoutStatus {
  COMPLETED
  CANCELED
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model Exercise {
  id           Int      @id @default(autoincrement())
  slug         String   @unique
  name         String
  description  String?
  instructions String?
  muscleGroup  String?
  equipment    String?
  demoVideoUrl String?
  thumbnailUrl String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workoutExercises WorkoutExercise[]

  @@index([name])
  @@index([muscleGroup])
  @@index([isActive])
}

model TrainingWorkout {
  id          Int      @id @default(autoincrement())
  coachId     Int
  name        String
  description String?
  duration    Int?
  difficulty  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  coach           User              @relation("TrainingWorkoutCoach", fields: [coachId], references: [id], onDelete: Cascade)
  exercises       WorkoutExercise[]
  programWorkouts ProgramWorkout[]

  @@index([coachId])
  @@index([isActive])
}

model WorkoutExercise {
  id             Int      @id @default(autoincrement())
  workoutId      Int
  exerciseId     Int
  position       Int
  sets           Int?
  repetitions    Int?
  minRepetitions Int?
  maxRepetitions Int?
  duration       Int?
  restSeconds    Int?
  targetWeight   Float?
  tempo          String?
  coachNotes     String?
  coachVideoUrl  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workout  TrainingWorkout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([workoutId, position])
  @@index([workoutId])
  @@index([exerciseId])
}

model TrainingProgram {
  id            Int      @id @default(autoincrement())
  coachId       Int
  name          String
  description   String?
  durationWeeks Int?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  coach       User                @relation("TrainingProgramCoach", fields: [coachId], references: [id], onDelete: Cascade)
  workouts    ProgramWorkout[]
  assignments ProgramAssignment[]

  @@index([coachId])
  @@index([isActive])
}

model ProgramWorkout {
  id        Int      @id @default(autoincrement())
  programId Int
  workoutId Int
  week      Int?
  day       Int?
  position  Int
  createdAt DateTime @default(now())

  program     TrainingProgram            @relation(fields: [programId], references: [id], onDelete: Cascade)
  workout     TrainingWorkout            @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  completions ProgramWorkoutCompletion[]

  @@unique([programId, position])
  @@index([programId])
  @@index([workoutId])
}

model ProgramAssignment {
  id         Int       @id @default(autoincrement())
  programId  Int
  clientId   Int
  assignedBy Int
  startDate  DateTime?
  endDate    DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  program     TrainingProgram            @relation(fields: [programId], references: [id], onDelete: Cascade)
  client      User                       @relation("ProgramClient", fields: [clientId], references: [id], onDelete: Cascade)
  coach       User                       @relation("ProgramAssignedBy", fields: [assignedBy], references: [id], onDelete: Cascade)
  completions ProgramWorkoutCompletion[]

  @@index([programId])
  @@index([clientId])
  @@index([assignedBy])
  @@index([clientId, isActive])
}

model ProgramWorkoutCompletion {
  id               Int      @id @default(autoincrement())
  assignmentId     Int
  programWorkoutId Int
  workoutSessionId Int      @unique
  completedAt      DateTime @default(now())
  createdAt        DateTime @default(now())

  assignment     ProgramAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  programWorkout ProgramWorkout    @relation(fields: [programWorkoutId], references: [id], onDelete: Cascade)
  workoutSession WorkoutSession    @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, programWorkoutId])
  @@index([assignmentId])
  @@index([programWorkoutId])
}

model CoachInvite {
  id         Int       @id @default(autoincrement())
  token      String    @unique
  coachId    Int
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  coach User @relation("CoachInvites", fields: [coachId], references: [id], onDelete: Cascade)

  @@index([coachId])
  @@index([expiresAt])
}

model Subscription {
  id                    Int       @id @default(autoincrement())
  userId                Int
  provider              String
  platform              String
  productId             String
  plan                  String
  status                String
  transactionId         String?   @unique
  originalTransactionId String?
  purchasedAt           DateTime?
  expiresAt             DateTime?
  lastVerifiedAt        DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([originalTransactionId])
  @@index([expiresAt])
}
