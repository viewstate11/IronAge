/* =========================================================
   RELOCALIZE EXISTING DAILY REMINDERS
========================================================= */

function parseReminderTime(
  value: unknown,
  fallbackHour: number,
  fallbackMinute: number
): {
  hour: number;
  minute: number;
} {
  if (
    typeof value !== "string" ||
    !/^\d{2}:\d{2}$/.test(value)
  ) {
    return {
      hour: fallbackHour,
      minute: fallbackMinute,
    };
  }

  const [hour, minute] =
    value.split(":").map(Number);

  if (
    !Number.isInteger(hour) ||
    !Number.isInteger(minute) ||
    hour < 0 ||
    hour > 23 ||
    minute < 0 ||
    minute > 59
  ) {
    return {
      hour: fallbackHour,
      minute: fallbackMinute,
    };
  }

  return { hour, minute };
}

export async function rescheduleLocalizedNotifications():
  Promise<void> {
  if (
    !isNativeNotificationsAvailable() ||
    typeof window === "undefined"
  ) {
    return;
  }

  const permission =
    await LocalNotifications
      .checkPermissions();

  if (permission.display !== "granted") {
    return;
  }

  let settings = {
    workoutReminders: true,
    progressUpdates: true,
    nutritionReminders: false,
    motivationalMessages: true,
  };

  let times = {
    workout: "18:00",
    nutritionMorning: "09:00",
    nutritionAfternoon: "13:00",
    nutritionEvening: "19:00",
    motivation: "07:30",
  };

  try {
    const rawSettings =
      localStorage.getItem(
        "ironage_notification_settings"
      );

    if (rawSettings) {
      settings = {
        ...settings,
        ...JSON.parse(rawSettings),
      };
    }

    const rawTimes =
      localStorage.getItem(
        "ironage_notification_times"
      );

    if (rawTimes) {
      times = {
        ...times,
        ...JSON.parse(rawTimes),
      };
    }
  } catch {
    // Keep safe defaults.
  }

  if (settings.workoutReminders) {
    const workout =
      parseReminderTime(
        times.workout,
        18,
        0
      );

    await scheduleWorkoutReminder(
      workout.hour,
      workout.minute
    );
  }

  if (settings.nutritionReminders) {
    const morning =
      parseReminderTime(
        times.nutritionMorning,
        9,
        0
      );

    const afternoon =
      parseReminderTime(
        times.nutritionAfternoon,
        13,
        0
      );

    const evening =
      parseReminderTime(
        times.nutritionEvening,
        19,
        0
      );

    await scheduleNutritionReminders(
      morning,
      afternoon,
      evening
    );
  }

  if (settings.motivationalMessages) {
    const motivation =
      parseReminderTime(
        times.motivation,
        7,
        30
      );

    await scheduleMotivationReminder(
      motivation.hour,
      motivation.minute
    );
  }
}
