/* =========================================
   IRONAGE DASHBOARD
   PREMIUM BLACK × GOLD
========================================= */

.dashboard {
  position: relative;
  width: 100%;
  min-height: 100vh;
  min-height: 100dvh;
  overflow-x: hidden;
  background: #050505;
  color: #ffffff;
  padding-bottom: calc(110px + env(safe-area-inset-bottom));
}

.dashboard-hero {
  position: relative;
  width: 100%;
  min-height: 620px;
  overflow: hidden;
  background: #050505;
}

.dashboard-hero-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  object-position: center top;
  z-index: 0;
}

.dashboard-hero-overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background:
    linear-gradient(
      180deg,
      rgba(5, 5, 5, 0.82) 0%,
      rgba(5, 5, 5, 0.22) 28%,
      rgba(5, 5, 5, 0.52) 58%,
      #050505 100%
    );
}

.dashboard-hero-overlay::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(
      circle at 50% 34%,
      transparent 15%,
      rgba(0, 0, 0, 0.55) 100%
    );
}

.dashboard-hero-content {
  position: relative;
  z-index: 2;
  width: 100%;
  min-height: 620px;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding:
    max(18px, env(safe-area-inset-top))
    20px
    24px;
}

.dashboard-header {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.dashboard-logo {
  color: #ffffff;
  font-size: 21px;
  font-weight: 900;
  line-height: 1;
  letter-spacing: 0.16em;
}

.dashboard-logo span {
  color: #d4af37;
}

.dashboard-edition {
  margin-top: 7px;
  color: rgba(255, 255, 255, 0.48);
  font-size: 7px;
  font-weight: 800;
  line-height: 1;
  letter-spacing: 0.22em;
}

.dashboard-avatar {
  flex: 0 0 auto;
  width: 46px;
  height: 46px;
  padding: 2px;
  border: 1px solid rgba(212, 175, 55, 0.72);
  border-radius: 50%;
  background: #080808;
  overflow: hidden;
  cursor: pointer;
}

.dashboard-avatar img {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  border-radius: 50%;
}

.dashboard-hero-copy {
  width: 100%;
  margin-top: auto;
  margin-bottom: 24px;
}

.dashboard-eyebrow {
  display: flex;
  align-items: center;
  gap: 9px;
  color: #d4af37;
  font-size: 8px;
  font-weight: 900;
  line-height: 1;
  letter-spacing: 0.24em;
}

.dashboard-eyebrow::before {
  content: "";
  flex: 0 0 auto;
  width: 24px;
  height: 1px;
  background: #d4af37;
  box-shadow: 0 0 10px rgba(212, 175, 55, 0.65);
}

.dashboard-hero-copy h1 {
  margin: 16px 0 0;
  max-width: 100%;
  color: #ffffff;
  font-size: clamp(48px, 14.5vw, 72px);
  font-weight: 900;
  line-height: 0.9;
  letter-spacing: -0.055em;
  word-break: break-word;
}

.dashboard-hero-copy h1 strong {
  color: #d4af37;
  font-weight: 900;
}

.dashboard-hero-copy p {
  margin: 18px 0 0;
  max-width: 340px;
  color: rgba(255, 255, 255, 0.70);
  font-size: 13px;
  font-weight: 500;
  line-height: 1.55;
}

.dashboard-start {
  width: 100%;
  height: 60px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20px;
  border: 1px solid #d4af37;
  border-radius: 18px;
  background: #d4af37;
  color: #050505;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.15em;
  cursor: pointer;
  box-shadow: 0 14px 34px rgba(212, 175, 55, 0.20);
}

.dashboard-start strong {
  font-size: 21px;
  line-height: 1;
}

.dashboard-start:active {
  transform: scale(0.985);
}

.dashboard-stats {
  width: calc(100% - 40px);
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin: 0 20px;
  padding: 22px 0;
  box-sizing: border-box;
  border-top: 1px solid rgba(212, 175, 55, 0.22);
  border-bottom: 1px solid rgba(212, 175, 55, 0.22);
}

.dashboard-stat {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 2px 8px;
  border-right: 1px solid rgba(255, 255, 255, 0.10);
}

.dashboard-stat:last-child {
  border-right: none;
}

.dashboard-stat span {
  color: rgba(255, 255, 255, 0.48);
  font-size: 7px;
  font-weight: 800;
  line-height: 1;
  letter-spacing: 0.16em;
}

.dashboard-stat strong {
  max-width: 100%;
  margin-top: 7px;
  overflow: hidden;
  color: #ffffff;
  font-size: clamp(22px, 7vw, 28px);
  font-weight: 800;
  line-height: 1;
  text-overflow: ellipsis;
}

.dashboard-stat small {
  margin-top: 7px;
  color: #d4af37;
  font-size: 6px;
  font-weight: 900;
  line-height: 1;
  letter-spacing: 0.14em;
}

.dashboard-section {
  width: 100%;
  padding: 30px 20px 0;
  box-sizing: border-box;
}

.dashboard-section-heading {
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18px;
  margin-bottom: 15px;
}

.dashboard-section-heading > div {
  min-width: 0;
}

.dashboard-section-heading > div > span {
  color: #d4af37;
  font-size: 7px;
  font-weight: 900;
  line-height: 1;
  letter-spacing: 0.20em;
}

.dashboard-section-heading h2 {
  margin: 7px 0 0;
  color: #ffffff;
  font-size: 24px;
  font-weight: 800;
  line-height: 1.05;
  letter-spacing: -0.03em;
}

.dashboard-section-heading button {
  flex: 0 0 auto;
  min-height: 32px;
  padding: 0;
  border: 0;
  background: transparent;
  color: #d4af37;
  font-size: 7px;
  font-weight: 900;
  letter-spacing: 0.14em;
  cursor: pointer;
}

.dashboard-mission {
  width: 100%;
  min-height: 104px;
  display: grid;
  grid-template-columns: 42px minmax(0, 1fr) 28px;
  align-items: center;
  gap: 12px;
  padding: 16px;
  box-sizing: border-box;
  border: 1px solid rgba(212, 175, 55, 0.24);
  border-radius: 18px;
  background:
    linear-gradient(
      115deg,
      rgba(212, 175, 55, 0.09),
      rgba(12, 12, 12, 0.96)
    );
  color: #ffffff;
  text-align: left;
  cursor: pointer;
}

.dashboard-mission:active {
  transform: scale(0.988);
}

.mission-number {
  color: #d4af37;
  font-size: 20px;
  font-weight: 800;
  line-height: 1;
}

.mission-info {
  min-width: 0;
}

.mission-info span {
  color: #d4af37;
  font-size: 7px;
  font-weight: 800;
  letter-spacing: 0.15em;
}

.mission-info h3 {
  margin: 6px 0 0;
  overflow: hidden;
  color: #ffffff;
  font-size: 15px;
  font-weight: 900;
  line-height: 1.1;
  letter-spacing: 0.06em;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mission-info p {
  margin: 6px 0 0;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.50);
  font-size: 9px;
  line-height: 1.35;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mission-arrow {
  color: #d4af37;
  font-size: 21px;
  line-height: 1;
  text-align: right;
}

.dashboard-quote {
  width: calc(100% - 40px);
  margin: 36px 20px 0;
  padding: 25px 0;
  box-sizing: border-box;
  border-top: 1px solid rgba(255, 255, 255, 0.10);
  border-bottom: 1px solid rgba(255, 255, 255, 0.10);
}

.quote-accent {
  width: 32px;
  height: 2px;
  margin-bottom: 17px;
  background: #d4af37;
  box-shadow: 0 0 10px rgba(212, 175, 55, 0.60);
}

.dashboard-quote p {
  margin: 0;
  color: #ffffff;
  font-size: 17px;
  font-weight: 800;
  line-height: 1.28;
  letter-spacing: -0.02em;
}

.dashboard-quote p strong {
  color: #d4af37;
}

.dashboard-quote > span {
  display: block;
  margin-top: 17px;
  color: rgba(255, 255, 255, 0.36);
  font-size: 6px;
  font-weight: 800;
  letter-spacing: 0.20em;
}

.dashboard-quick {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 28px 20px 0;
  box-sizing: border-box;
}

.dashboard-quick button {
  width: 100%;
  height: 58px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 18px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 16px;
  background:
    linear-gradient(
      110deg,
      rgba(255, 255, 255, 0.025),
      rgba(255, 255, 255, 0.01)
    );
  color: #ffffff;
  cursor: pointer;
}

.dashboard-quick button:active {
  transform: scale(0.988);
}

.dashboard-quick button span {
  font-size: 8px;
  font-weight: 900;
  letter-spacing: 0.17em;
}

.dashboard-quick button strong {
  color: #d4af37;
  font-size: 18px;
  line-height: 1;
}

@media (max-width: 390px) {
  .dashboard-hero,
  .dashboard-hero-content {
    min-height: 590px;
  }

  .dashboard-hero-copy h1 {
    font-size: 48px;
  }

  .dashboard-section-heading h2 {
    font-size: 22px;
  }
}

@media (min-width: 430px) {
  .dashboard-hero,
  .dashboard-hero-content {
    min-height: 640px;
  }

  .dashboard-hero-content {
    padding-left: 22px;
    padding-right: 22px;
  }

  .dashboard-stats {
    width: calc(100% - 44px);
    margin-left: 22px;
    margin-right: 22px;
  }

  .dashboard-section {
    padding-left: 22px;
    padding-right: 22px;
  }

  .dashboard-quote {
    width: calc(100% - 44px);
    margin-left: 22px;
    margin-right: 22px;
  }

  .dashboard-quick {
    padding-left: 22px;
    padding-right: 22px;
  }
}
